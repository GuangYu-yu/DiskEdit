#!/bin/sh
# Carrier init.
#
# The host passes the session token on the kernel command line; the worker
# refuses to start without it on a terminal, so this script exports it and
# replaces itself with the worker. stdout/stderr are the serial console, which
# is also the protocol transport.

set -eu

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

token=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        diskedit.token=*) token=${arg#diskedit.token=} ;;
    esac
done

if [ -z "$token" ]; then
    echo "carrier init: diskedit.token is missing from the kernel command line" >&2
    exit 3
fi

export DISKEDIT_WORKER_TOKEN="$token"
exec /bin/diskedit __worker
