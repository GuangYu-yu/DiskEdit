# Guest kernel configuration for the VM carrier.
#
# Keep this list minimal: virtio-blk carries the target, virtio-rng supplies
# entropy to the worker, and the console carries the protocol. The console
# driver differs by architecture; enable the one that matches the bundle.

CONFIG_64BIT=y
CONFIG_BINFMT_ELF=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_RNG=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_BLK_DEV=y
# 分区上的 FS 工具通过 loop 设备工作（镜像不是块设备）；defconfig 把 loop 编成模块，
# guest 没有模块目录，所以必须内建
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# x86_64
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# aarch64
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
